# Single-stage Dockerfile (Reverted from multi-stage)
FROM node:20.18
WORKDIR /app

# Install ffmpeg for audio processing
RUN apt-get update && apt-get install -y ffmpeg

# Build arguments from Cloud Build
ARG GOOGLE_CLIENT_ID
ARG NEXT_PUBLIC_BASE_URL
ARG FIREBASE_PROJECT_ID
ARG FIREBASE_CLIENT_EMAIL
ARG NEXT_PUBLIC_FIREBASE_API_KEY
ARG NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN
ARG NEXT_PUBLIC_FIREBASE_PROJECT_ID
ARG NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET
ARG NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID
ARG NEXT_PUBLIC_FIREBASE_APP_ID
ARG NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID
ARG VERTEX_CLIENT_EMAIL
ARG CLASSROOM_CLIENT_ID
ARG CLASSROOM_REDIRECT_URI

# Set non-secret build/runtime defaults from build args.
ENV AUTH_GOOGLE_ID=$GOOGLE_CLIENT_ID
ENV NEXT_PUBLIC_BASE_URL=$NEXT_PUBLIC_BASE_URL
ENV FIREBASE_PROJECT_ID=$FIREBASE_PROJECT_ID
ENV FIREBASE_CLIENT_EMAIL=$FIREBASE_CLIENT_EMAIL
ENV NEXT_PUBLIC_FIREBASE_API_KEY=$NEXT_PUBLIC_FIREBASE_API_KEY
ENV NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=$NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN
ENV NEXT_PUBLIC_FIREBASE_PROJECT_ID=$NEXT_PUBLIC_FIREBASE_PROJECT_ID
ENV NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=$NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET
ENV NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=$NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID
ENV NEXT_PUBLIC_FIREBASE_APP_ID=$NEXT_PUBLIC_FIREBASE_APP_ID
ENV NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=$NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID
ENV VERTEX_CLIENT_EMAIL=$VERTEX_CLIENT_EMAIL
ENV CLASSROOM_CLIENT_ID=$CLASSROOM_CLIENT_ID
ENV CLASSROOM_REDIRECT_URI=$CLASSROOM_REDIRECT_URI

# Non-secret placeholders for build-time imports. Real values are injected by Cloud Run
# from Secret Manager at runtime.
ENV DATABASE_URL="postgresql://placeholder:placeholder@localhost:5432/placeholder?schema=public"
ENV SERVICE_ACCOUNT_KEY="{}"
ENV NEXTAUTH_SECRET=""
ENV AUTH_GOOGLE_SECRET=""
ENV OPENAI_API_KEY=""
ENV FIREBASE_PRIVATE_KEY=""
ENV GOOGLE_TEXT_TO_SPEECH_API_KEY=""
ENV ACCESS_KEY=""
ENV DISCORD_WEBHOOK_URL=""
ENV VERTEX_PRIVATE_KEY=""
ENV CLASSROOM_CLIENT_SECRET=""
ENV NODE_OPTIONS="--max-old-space-size=6144"

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci --legacy-peer-deps

# Copy Prisma schema and generate client
COPY prisma ./prisma/
RUN npx prisma generate

# Copy remaining source code
COPY . .

# Build Next.js application
RUN npm run build

# Expose port
EXPOSE 3000

# Start the application
CMD ["npm", "start"]
